rules_version = '2';
// Reglas de seguridad de Refri Familiar.
// Solo los integrantes de un hogar pueden ver o cambiar su refri, su lista y su historial.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function home(hid) { return get(/databases/$(database)/documents/households/$(hid)).data; }
    function isMember(hid) { return signedIn() && request.auth.uid in home(hid).members; }

    // Perfil propio: solo tú lo lees y lo escribes.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Códigos para unirse: cualquiera con sesión puede consultar un código exacto (no listarlos).
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.hid)).data.members;
      allow update, delete: if false;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Integrantes cambian todo; alguien con el código solo puede agregarse a sí mismo (máximo 8 personas).
      allow update: if isMember(hid) || (
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && resource.data.members.size() < 8
      );
      allow delete: if false;

      match /{sub}/{id} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
